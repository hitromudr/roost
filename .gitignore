bin/
.env

# Answers about one machine and one person: what the stand is called, which
# repositories belong on it, which hosts ansible talks to. The examples next
# to them are what travels.
roost.conf
projects.conf
ansible/inventory
# Variables the CLI does not pass, kept per stand: `egress_sandbox_allow` is a
# property of the network the machine sits in. Ansible reads this directory
# next to the playbook on every run, `roost install` included.
ansible/playbooks/group_vars/
*.log

# Ansible's own working directory next to ansible.cfg: a lock file and empty
# places for roles and collections it would fetch. Made by every run from the
# repository root, and carrying nothing worth keeping.
.ansible/

__pycache__/
.venv/
node_modules/
.DS_Store
