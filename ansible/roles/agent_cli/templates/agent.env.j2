# {{ ansible_managed }}
# What roost installed as the agent, and where. Read by `roost doctor` and by
# `roost install`, which puts this command into the launcher's configuration.
#
# A path here does not mean roost owns the binary: an agent that was already on
# the machine is recorded as found, not installed, and teardown leaves it be.
AGENT_INSTALLED_COMMAND={{ agent_cli_resolved_command }}
AGENT_INSTALLED_BY={{ 'roost' if agent_cli_installed_now | default(false) else 'found' }}
AGENT_INSTALLED_VERSION={{ agent_cli_version | default('unknown') }}
