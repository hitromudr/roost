# {{ ansible_managed }}
# How the terminal is published, and by whom. `roost qr` reads the address from
# here; `roost uninstall` removes what is listed and nothing else — in
# particular it does not remove an nginx that was already on the machine.
EXPOSE_HOST={{ expose_resolved_host }}
EXPOSE_TLS_PORT={{ expose_tls_port }}
EXPOSE_URL={{ 'https://' + expose_resolved_host + ':' + (expose_tls_port | string) if expose_cert_present | bool else '' }}
EXPOSE_VHOST={{ expose_vhost_file }}
EXPOSE_WEBROOT={{ expose_webroot }}
# Whether roost created that directory. Teardown removes it only when this says
# so: expose_webroot can be pointed at a webroot the machine already serves
# from, and removing that would take somebody's site with it.
EXPOSE_WEBROOT_OWNED={{ 'true' if (expose_webroot_created is defined and expose_webroot_created is changed) or ('EXPOSE_WEBROOT_OWNED=true' in expose_prev_state) else 'false' }}
EXPOSE_CERT={{ expose_cert_root }}/{{ expose_resolved_host }}
EXPOSE_UPSTREAM={{ expose_upstream }}
EXPOSE_NGINX_OWNED={{ 'true' if (expose_nginx_installed is defined and expose_nginx_installed is changed) or (expose_nginx_owned | bool) else 'false' }}
