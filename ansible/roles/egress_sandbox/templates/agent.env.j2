# {{ ansible_managed }}
# Read by the launcher when it is invoked as {{ item.key }}{{ egress_sandbox_agent_suffix }}.
# The binary, and whatever egress_sandbox_agent_env names for this agent (its
# own proxy file, variables that pin its mode). Values here outrank the
# caller's environment. The group and the profile belong to the machine and
# stay in the launcher's own configuration.
AGENT_COMMAND={{ item.value }}
{% for key, value in (egress_sandbox_agent_env.get(item.key, {}) | dictsort) %}
{{ key }}={{ value }}
{% endfor %}
