# {{ ansible_managed }}
# Read by the launcher when it is invoked as {{ item.key }}{{ egress_sandbox_agent_suffix }}.
# Only the binary is named here. The group, the proxy and the profile belong to
# the machine and stay in the launcher's own configuration, so every agent on it
# is bound by one policy rather than by a copy of it each.
AGENT_COMMAND={{ item.value }}
