# {{ ansible_managed }}
# Read by the agent-run wrapper. Credentials are not here — they live in
# {{ egress_sandbox_env_file }} with 0600 permissions.
AGENT_GROUP={{ egress_sandbox_group }}
AGENT_COMMAND={{ egress_sandbox_agent_command }}
AGENT_ENV_FILE={{ egress_sandbox_env_file }}
# The launcher refuses to start without a proxy unless this says `direct`.
AGENT_PROFILE={{ egress_sandbox_profile }}
