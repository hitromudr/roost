#!/usr/bin/env bash
# agent-run — start a CLI agent inside the sandbox group.
#
# The group is what the firewall policy matches on, so everything the agent
# spawns inherits the same restrictions. Proxy settings come from an env file
# with 0600 permissions: credentials do not belong in a script that the whole
# machine can read.
#
#   agent-run [args...]     start the configured agent, passing args through
#   codex-safe [args...]    the same, for the agent named by the link's name
#
# Configuration comes from /etc/roost/agent-run.env (written by the ansible
# role), and any variable already set in the environment wins over it:
#   AGENT_GROUP     group to run under
#   AGENT_COMMAND   the agent binary
#   AGENT_ENV_FILE  optional file with PROXY_URL and anything else it needs
#
# A second agent is a second name for this script, not a second script: a
# symlink called `codex-safe` (or `codex-run`) reads
# /etc/roost/agents/codex.env, which names that agent's binary, and everything
# else — group, proxy, profile — stays the one policy both agents share. A
# wrapper per agent would mean a copy of that policy per agent, and copies
# disagree.
set -euo pipefail

die() { printf '%s: %s\n' "$SELF" "$*" >&2; exit 1; }

SELF="$(basename -- "$0")"

# Read key=value into the environment without overriding what is already
# there. Callers load the most specific file first for that reason.
load_env() {
	[ -f "$1" ] || return 0
	while IFS='=' read -r key value; do
		case "$key" in '' | \#*) continue ;; esac
		# Environment wins: a one-off override should not need the file
		# edited, and the tests rely on this too.
		[ -n "${!key:-}" ] || export "$key=$value"
	done < "$1"
}

CONFIG="${AGENT_CONFIG:-/etc/roost/agent-run.env}"
AGENT_DIR="${AGENT_DIR:-/etc/roost/agents}"

# The name the launcher was invoked as selects the agent. `-safe` matches the
# wrapper names these machines already use for Claude; `-run` matches this
# script's own. A link whose agent has no file is a typo or a half-finished
# install, and saying so here is the difference between a message and a
# session that dies the moment tmux opens it.
case "$SELF" in
	agent-run) ;;
	*)
		agent="${SELF%-safe}"
		agent="${agent%-run}"
		[ -f "$AGENT_DIR/$agent.env" ] ||
			die "no agent named '$agent': $AGENT_DIR/$agent.env is missing"
		# The name is the request, so here it outranks the environment — the
		# one place where it does. An agent's session carries the
		# AGENT_COMMAND that opened it, so a launcher started from inside a
		# session (a helper, a second window, a button that runs a command in
		# the current one) would otherwise start that agent again under this
		# one's name, and report the wrong version when asked.
		unset AGENT_COMMAND
		load_env "$AGENT_DIR/$agent.env"
		# An agent file naming a launcher would loop: the launcher resolves the
		# name, finds the launcher, runs it. Cheap to say once.
		if [ "$(readlink -f -- "${AGENT_COMMAND:-/nonexistent}" 2>/dev/null)" = "$(readlink -f -- "$0")" ]; then
			die "$AGENT_DIR/$agent.env names this launcher instead of an agent"
		fi
		;;
esac

load_env "$CONFIG"

GROUP="${AGENT_GROUP:-}"
COMMAND="${AGENT_COMMAND:-}"
ENV_FILE="${AGENT_ENV_FILE:-}"
PROFILE="${AGENT_PROFILE:-pinned}"

[ -n "$GROUP" ]   || die "AGENT_GROUP is not set"
[ -n "$COMMAND" ] || die "AGENT_COMMAND is not set"

# An agent that is not there is the failure that hides: `sg` reports "command
# not found" and exits 127, and a session started for it closes in the same
# instant — on a phone that reads as a button that does nothing. Checked here,
# where the name is still known.
case "$COMMAND" in
	*/*) [ -x "$COMMAND" ] || die "AGENT_COMMAND=$COMMAND is not an executable file" ;;
	*)   command -v "$COMMAND" >/dev/null 2>&1 || die "AGENT_COMMAND=$COMMAND is not in PATH" ;;
esac

if [ -n "$ENV_FILE" ] && [ -f "$ENV_FILE" ]; then
	# Credentials in a world-readable file are a misconfiguration worth
	# stopping for: every account on the machine could read the proxy
	# password, and nobody would notice.
	perms="$(stat -c '%a' "$ENV_FILE")"
	case "$perms" in
		# 640 is the normal case: root owns it, the sandbox group reads it.
		# Anything world-readable is a misconfiguration worth stopping for.
		600|640|400|440) ;;
		*) die "$ENV_FILE has permissions $perms — expected 0600 or 0640, refusing to read credentials from it" ;;
	esac
	[ -r "$ENV_FILE" ] || die "$ENV_FILE is not readable by $(id -un) — check its group"

	# shellcheck disable=SC1090
	. "$ENV_FILE"
fi

# On every profile but `direct` the proxy is the only sanctioned way out, so
# starting without one is refused rather than attempted. The firewall rules
# would normally stop such an agent anyway — but "normally" is doing too much
# work in a sentence about an account that gets banned for one request from an
# unexpected address. Two independent things now have to fail before a single
# packet leaves this machine directly: these rules, and this check.
if [ -z "${PROXY_URL:-}" ] && [ "$PROFILE" != direct ]; then
	die "no PROXY_URL${ENV_FILE:+ in $ENV_FILE} and the profile is '$PROFILE' — refusing to start the agent with no proxy to go through. Fix the file, or set AGENT_PROFILE=direct if unrestricted egress is what you want."
fi

if [ -n "${PROXY_URL:-}" ]; then
	export HTTPS_PROXY="$PROXY_URL" HTTP_PROXY="$PROXY_URL" ALL_PROXY="$PROXY_URL"
	export https_proxy="$PROXY_URL" http_proxy="$PROXY_URL" all_proxy="$PROXY_URL"
	# Without this the agent would try to reach a local service through the
	# proxy, which the proxy has no route to.
	export NO_PROXY="localhost,127.0.0.1" no_proxy="localhost,127.0.0.1"
fi

# A hook for the test suite: show what the environment would be, then carry on.
if [ -n "${AGENT_DEBUG_ENV:-}" ]; then
	echo "HTTPS_PROXY=${HTTPS_PROXY:-}"
	echo "NO_PROXY=${NO_PROXY:-}"
fi

# Quote every argument so a prompt with spaces survives the trip through sg.
printf -v args '%q ' "$COMMAND" "$@"

restore_terminal() {
	# A TUI agent that exits badly leaves the terminal in alternate-screen
	# mode with the cursor hidden. Put it back — but only when there is a
	# terminal to put back: written to a pipe these escapes become part of the
	# output, and a caller parsing it (a test, a script, a session helper)
	# reads them as data. The exit status survives either way, the reset runs
	# from a trap rather than as the last command.
	[ -t 1 ] && [ -n "${TERM:-}" ] || return 0
	printf '\e[?1049l\e[?25h\e[0m'
	stty sane 2>/dev/null || true
}
trap restore_terminal EXIT

sg "$GROUP" -c "$args"
