# {{ ansible_managed }}
# Public entry to the stand. The terminal itself listens on this machine's
# loopback, at the far end of the stand's reverse tunnel.
server {
{% if gate_nginx_version is version('1.25.1', '>=') %}
    listen 443 ssl;
    http2 on;
{% else %}
    # nginx older than 1.25.1: http2 is a listen flag, the directive does not
    # exist and would be a fatal error.
    listen 443 ssl http2;
{% endif %}
    server_name {{ gate_domain }};

    ssl_certificate     {{ gate_tls_cert }};
    ssl_certificate_key {{ gate_tls_key }};
{% if gate_auth == 'mtls' %}

    # Only devices holding a certificate from this CA get as far as a
    # request; everyone else fails the handshake.
    ssl_client_certificate {{ gate_ca_dir }}/ca.crt;
    ssl_verify_client on;
{% endif %}

    # It is a shell. Keep it out of search engines and out of frames.
    add_header X-Robots-Tag "noindex, nofollow" always;
    add_header X-Frame-Options "DENY" always;

    location / {
        proxy_pass http://127.0.0.1:{{ gate_upstream_port }};

        # WebSocket upgrade for /ws — without it the terminal connects and
        # immediately drops.
        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "upgrade";

        # pockterm compares Origin against Host and refuses the upgrade when
        # a proxy rewrites it.
        proxy_set_header Host $host;

        # Terminal output must arrive as produced, not in batches.
        proxy_buffering off;

        # A session sits idle while you read; the default 60s would cut it.
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }
}

server {
    listen 80;
    server_name {{ gate_domain }};
    return 301 https://$host$request_uri;
}
