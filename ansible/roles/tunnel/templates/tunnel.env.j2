# {{ ansible_managed }}
# The way in for a machine with no address of its own. `roost gate` reads this to
# print what the gate needs; teardown reads it to remove what roost put here.
TUNNEL_GATE={{ tunnel_gate }}
TUNNEL_REMOTE_PORT={{ tunnel_remote_port }}
TUNNEL_LOCAL={{ tunnel_local }}
TUNNEL_KEY={{ tunnel_key }}
TUNNEL_PUBKEY={{ tunnel_key }}.pub
TUNNEL_UNIT={{ tunnel_unit }}
TUNNEL_USER={{ tunnel_user }}
