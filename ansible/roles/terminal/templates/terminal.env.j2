# {{ ansible_managed }}
# roost installed the web terminal on this machine. This file is what says so:
# the role refuses to touch a pockterm unit that exists without it, and
# teardown removes what is listed here and nothing else.
TERMINAL_UNIT={{ terminal_unit }}
TERMINAL_ENV_FILE={{ terminal_env_file }}
TERMINAL_LISTEN={{ terminal_listen }}
TERMINAL_SRC={{ terminal_src }}
TERMINAL_SESSION_DIR={{ terminal_project_dir }}
TERMINAL_USER={{ terminal_user }}
{% if not (terminal_go_system_ok | bool) %}
TERMINAL_GO_DIR={{ terminal_go_dir }}
{% endif %}
