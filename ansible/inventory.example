# Copy to `ansible/inventory` and edit. Run playbooks from the repository
# root, where ansible.cfg points at ansible/roles. The stand is the machine agents run on; the
# gate is the public entry point and is only needed when the stand has no
# routable address of its own.
#
# `stand` can be localhost when you are installing on the machine itself:
#   stand-1 ansible_connection=local

[stand]
stand-1 ansible_host=192.0.2.10 ansible_user=you

[gate]
# gate-1 ansible_host=203.0.113.5 ansible_user=root
