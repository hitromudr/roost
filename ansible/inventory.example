# Copy to `ansible/inventory` and edit. Run playbooks from the repository
# root, where ansible.cfg points at ansible/roles.
#
# One group: the machines roost configures. `stand` can be localhost when you
# are installing on the machine itself:
#   stand-1 ansible_connection=local
#
# The projects playbook is useful on a machine that runs no agents at all — a
# workstation wanting the same checkouts belongs in this group too.

[stand]
stand-1 ansible_host=192.0.2.10 ansible_user=you
