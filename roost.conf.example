# roost.conf — answers about this machine and this person.
#
# `roost setup` writes this file from a few questions; `roost up` and
# `roost install` read it. It is gitignored, and this example is what travels:
# copy it, edit it, or just run the wizard.
#
#   cp roost.conf.example roost.conf   # then edit
#   ./roost up

# --- the sandbox --------------------------------------------------------
# pinned   loopback only. The agent reaches the internet through a local proxy
#          that is itself outside the sandbox, so its exit address stays the
#          same wherever the machine is.
# proxied  the same, plus the destinations in `egress_sandbox_allow` — an
#          ansible variable of the role, not a key of this file: the list is
#          usually a property of the network, not of the machine.
# direct   no restrictions. Here so that "unrestricted" is a choice somebody
#          made rather than the result of skipping configuration.
egress_profile=pinned

# The proxy the sandbox goes out through. Written to
# /etc/roost/agent-proxy.env (0640, owned by the agent's account) by
# `roost install`; leave it empty and whatever is already in that file is kept.
#
# On the pinned and proxied profiles an agent with no proxy has no network at
# all — it fails on its first request, and `roost doctor` says so.
proxy_url=http://user:password@127.0.0.1:8129

# The address the agent's traffic is expected to leave from. Read this twice
# before releasing an agent that is logged in: a request from an address the
# provider does not expect is how accounts get suspended, and a local proxy
# that answers is not the same thing as a proxy that changes where you come
# from. `roost doctor` prints the real answer and compares it with this.
#
# Empty means unchecked — doctor then reports the address it found and says
# nothing was compared.
expected_exit=

# Where doctor asks. Any service that answers with the caller's address.
exit_probe=https://ifconfig.me

# --- the agent ----------------------------------------------------------
# The binary a session starts. Leave it empty to have roost install Claude
# Code (`roost agent`) and record the path it chose back into this file.
agent_command=

# Whether roost may install that binary at all. false leaves it to you: the
# sandbox, the sessions and the terminal are set up around whatever agent is
# already there, and `roost doctor` says so if there is none.
agent_install=true

# Further agents, name:command, comma-separated. Each gets a launcher of its
# own — `codex` below installs /usr/local/bin/codex-safe — sharing the group,
# the proxy and the profile with the agent above. One policy for all of them.
#   agents=codex:/home/you/.local/bin/codex
agents=

# Where projects live. Sessions are named after directories here.
project_dir=/home/you/work

# The environment repository: shell and editor config, agent settings — whatever
# you want the same on every machine you work from. It is checked out to
# <project_dir>/dotfiles and its own installer is run (./install.sh), so what a
# machine gets is decided by that repository and not by roost.
#
# If it carries encrypted files (*.sops.*), the age key has to be in place first:
# without it the secrets stay encrypted while the installer reports success, and
# the role refuses rather than let that happen quietly.
#
# Empty means there is none, which is a perfectly good stand.
env_repo=
# HEAD follows whatever the repository calls its default branch — `main` is the
# wrong guess for every repository still on `master`.
env_branch=HEAD

# --- the terminal, and the way in --------------------------------------
# A web terminal is installed only where there is none: a pockterm.service
# this machine already has keeps its owner, and roost says so and stops.
# false skips it entirely — sessions are plain tmux, so ssh -t or mosh work.
terminal=true
listen=127.0.0.1:8130

# The name your phone will open. Empty derives one from this machine's address
# through sslip.io (203-0-113-5.sslip.io for 203.0.113.5), which still gets a
# real certificate — so the page can be installed as an app without a domain
# of your own.
public_host=

# The port TLS is served on. Not 443: on a machine that does anything, 443
# usually already belongs to something, and taking it would make roost the
# second owner of somebody else's front door.
tls_port=8443

# Contact address for Let's Encrypt. Empty registers without one, which means
# no mail when a certificate is about to expire.
email=

# --- being reached at all, when this machine has no address -------------
# A stand behind NAT has nowhere for a phone to connect to. `gate` names
# somewhere that does — a VPS, a machine at work, anything with a routable
# address and an sshd:
#
#   gate=roost-tunnel@vps.example
#
# roost then holds one reverse forward open from here to there (a key of its own,
# a systemd unit, `roost tunnel`), and `roost gate` prints what the far end
# needs: an authorized_keys line permitting exactly that one forward, an sshd
# drop-in allowing it, and an nginx file serving the terminal through it. That
# half is printed rather than applied, because the gate is somebody else's
# machine — `roost gate --apply` will do it over your own ssh access if you ask.
#
# With a gate set, the certificate lives on the gate: it is the machine that can
# prove the name. `public_host` then points at the gate, and nothing is served
# from here.
#
# Empty means this machine is reachable directly, and `roost expose` serves the
# terminal from it.
gate=
gate_port=18130

# --- the lock on the door ----------------------------------------------
# token  the shared token pockterm puts in the URL your phone saves. What makes
#        the first run one command — and a credential that lives in browser
#        history and in the front's logs.
# mtls   a certificate on the device. roost keeps an authority of its own and
#        hands one device at a time its bundle:
#
#          roost enroll phone
#
#        which prints a QR code with a one-time link and the password its
#        importer will ask for. The bundle itself cannot be in the code — it is
#        4.4KB against a QR's 2953-byte ceiling — so the code is a link, and the
#        link stops existing ten minutes later whether or not it was used.
#
#        A lost phone is taken back out:
#          sudo roost-ca revoke phone && sudo systemctl reload nginx
client_auth=token
