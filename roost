#!/usr/bin/env bash
# roost — a confined place for CLI coding agents to run.
#
#   roost up        the whole thing: agent, sandbox, terminal, QR code
#   roost setup     answer a few questions, write roost.conf
#   roost install   apply the configuration to this machine
#   roost agent     install the agent binary if it is not here yet
#   roost terminal  put a web terminal on this machine (only if there is none)
#   roost expose    serve that terminal over TLS, and say at what address
#   roost enroll    let one device in, when the lock is client certificates
#   roost gate      what a machine with no address needs on the far end
#   roost qr        print the QR code your phone opens
#   roost token     replace the terminal's shared token
#   roost doctor    check that the sandbox is what it claims to be
#   roost projects [--list]         check out the repositories in projects.conf
#   roost uninstall [--purge]       remove roost from this machine
#
# Everything it does is an ansible role underneath; this wrapper exists so
# that the common path is one command and the questions are asked once.
#
# `install` is deliberately unchanged: the sandbox, the sessions and the
# environment, and nothing that touches a terminal or a front door. The
# machines already running roost call it, and a command that grew new
# responsibilities would break them on their next update. The pieces added in
# 2026-08 are their own commands, and `up` is the sequence.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONF="${ROOST_CONF:-$ROOT/roost.conf}"
PROXY_ENV="${ROOST_PROXY_ENV:-/etc/roost/agent-proxy.env}"
AGENT_STATE="${ROOST_AGENT_STATE:-/etc/roost/agent.env}"
AGENT_RUN_ENV="${ROOST_AGENT_RUN_ENV:-/etc/roost/agent-run.env}"
TERMINAL_STATE="${ROOST_TERMINAL_STATE:-/etc/roost/terminal.env}"
TUNNEL_STATE="${ROOST_TUNNEL_STATE:-/etc/roost/tunnel.env}"
EXPOSE_STATE="${ROOST_EXPOSE_STATE:-/etc/roost/expose.env}"
TERMINAL_ENV="${ROOST_TERMINAL_ENV:-/etc/pockterm/pockterm.env}"
# The terminal draws its own QR code, so roost does not carry one. Named as a
# variable because a stand may keep the binary somewhere else — and because a
# test has to be able to ask what happens when it is not installed, on a
# machine where it is.
POCKTERM_BIN="${ROOST_POCKTERM_BIN:-pockterm}"
# The authority and the enrolment command, installed by the expose role when the
# lock is client certificates.
CA_BIN="${ROOST_CA_BIN:-/usr/local/sbin/roost-ca}"
ENROLL_BIN="${ROOST_ENROLL_BIN:-/usr/local/sbin/roost-enroll}"

log()  { printf '\033[1;34m[roost]\033[0m %s\n' "$*"; }
ok()   { printf '\033[1;32m  ✓\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m  !\033[0m %s\n' "$*"; }
bad()  { printf '\033[1;31m  ✗\033[0m %s\n' "$*"; }
die()  { printf '\033[1;31m[roost]\033[0m %s\n' "$*" >&2; exit 1; }

usage() {
	sed -n '2,16p' "$ROOT/roost" | sed 's/^# \{0,1\}//'
}

# --- configuration ------------------------------------------------------

set_defaults() {
	egress_profile=pinned agent_command=/usr/local/bin/claude
	project_dir="$HOME/work"
	# The environment repository: shell and editor config, agent settings,
	# whatever else you want the same on every machine. Empty means the role
	# does nothing, which is the right default — a stand is useful without one.
	env_repo=""
	# Its branch. HEAD follows whatever the repository calls default, which is
	# not the same as `main` on a repository still using `master`.
	env_branch=HEAD
	# Further agents, `name:command` separated by commas. Each one gets a
	# launcher of its own — see agents_json below.
	agents=""
	# The proxy the sandbox reaches the internet through. Empty leaves
	# whatever is already in $PROXY_ENV alone, which is how a machine
	# configured by hand keeps its credentials.
	proxy_url=""
	# Let roost install the agent binary when there is none.
	agent_install=true
	# The web terminal, and the way in to it.
	terminal=true
	listen=127.0.0.1:8130
	# The address the agent's traffic is expected to leave from. The whole
	# point of the pinned profile is that this does not depend on where the
	# machine is — so it is worth stating, and worth checking before an agent
	# ever runs: an account can be suspended over one request from an address
	# its owner did not expect.
	#
	# Empty means unchecked, and `doctor` says so rather than staying quiet.
	expected_exit=""
	# Where to ask. Any service that answers with the caller's address.
	exit_probe=https://ifconfig.me
	# Empty derives a name from this machine's address through sslip.io, so a
	# machine with no domain still gets a real certificate.
	public_host=""
	tls_port=8443
	# Contact address for Let's Encrypt. Empty registers without one, which
	# means no mail when a certificate is about to expire.
	email=""
	# What the door is locked with.
	#
	# token  the string pockterm puts in the URL your phone saves. One command,
	#        and a credential that lives in browser history and in the front's
	#        logs.
	# mtls   a certificate on the device. Stronger, and not one button: a bundle
	#        is 4.4KB against a QR code's 2953, so the code carries a one-time
	#        link to it and the import password is typed once. `roost enroll`.
	client_auth=token
	# Where to be reached through, for a machine that has no address of its own:
	# user@host, or user@host:port. Empty means this machine is reachable
	# directly and `roost expose` serves the terminal here.
	gate=""
	# The port the forward listens on, on the gate's loopback.
	gate_port=18130
}

load_conf() {
	[ -f "$CONF" ] || die "no $CONF yet — run 'roost setup' first"
	# Simple key=value; no shell in the config file, on purpose.
	set_defaults
	while IFS='=' read -r key value; do
		case "$key" in '' | \#*) continue ;; esac
		printf -v "$key" '%s' "$value"
	done < "$CONF"
}

# Reading the config where there may not be one. `projects` is the command
# this exists for: a machine that runs no agents still wants the same
# checkouts, so demanding `roost setup` there would be asking about an egress
# profile that will never be used.
load_conf_optional() {
	set_defaults
	[ ! -f "$CONF" ] || load_conf
}

check_conf() {
	case "$egress_profile" in
		pinned | proxied | direct) ;;
		*) die "egress_profile is '$egress_profile' — expected pinned, proxied or direct" ;;
	esac
	agents_json >/dev/null
}

# agents_json prints the extra agents as JSON for ansible.
#
#   agents=codex:/home/dms/.local/bin/codex,qwen:/usr/local/bin/qwen
#
# Each becomes a launcher named after it (`codex-safe`), which starts that
# binary in the same group, through the same proxy, under the same profile as
# the main agent. The name goes into a file name and a launcher name, so it is
# checked here rather than left to produce a path nobody meant.
agents_json() {
	local first=1 entry name command
	local -a list=()
	# Split on commas without letting the shell glob a path on the way.
	IFS=',' read -ra list <<<"$agents"
	printf '{'
	for entry in "${list[@]}"; do
		[ -n "$entry" ] || continue
		name="${entry%%:*}" command="${entry#*:}"
		case "$name" in
			"" | *[!A-Za-z0-9_-]*) die "agents: '$name' is not a usable agent name (letters, digits, - and _)" ;;
		esac
		# No colon at all leaves command equal to the whole entry.
		if [ "$command" = "$entry" ] || [ -z "$command" ]; then
			die "agents: '$entry' has no command — expected name:/path/to/binary"
		fi
		[ $first -eq 1 ] || printf ','
		first=0
		printf '"%s":"%s"' "$name" "$command"
	done
	printf '}\n'
}

cmd_setup() {
	local profile agent proxy host lock
	log "a few questions; answers go to $CONF and are not asked again"
	read -rp "  egress profile [pinned/proxied/direct] (pinned): " profile
	read -rp "  agent command, or blank to have roost install one: " agent
	if [ "${profile:-pinned}" != direct ]; then
		# Asked here rather than left as homework: on the pinned and proxied
		# profiles a stand without a proxy has no network at all, and that is
		# the failure that looks like a broken agent.
		read -rp "  proxy the agent goes out through (http://user:pass@host:port): " proxy
	fi
	read -rp "  domain that points at this machine, or blank for an sslip.io name: " host
	read -rp "  lock on the terminal [token/mtls] (token): " lock
	cat > "$CONF" <<EOF
# Written by 'roost setup'. Edit freely; 'roost install' reads it.
egress_profile=${profile:-pinned}
agent_command=${agent:-}
project_dir=$HOME/work
# The environment repository — shell config, editor, agent settings — laid out
# on every machine you work from. Empty means there is none.
env_repo=
env_branch=HEAD
# Further agents, name:command, comma-separated. Each gets a launcher of its
# own — 'codex' below would install /usr/local/bin/codex-safe — sharing the
# group, the proxy and the profile with the agent above.
#   agents=codex:/home/you/.local/bin/codex
agents=
# The way out. Written into $PROXY_ENV (0640) by 'roost install'; leave it
# empty here and whatever is already in that file is kept.
proxy_url=${proxy:-}
# The web terminal and its address. roost installs a terminal only where there
# is none — a machine that already has one keeps its owner.
terminal=true
listen=127.0.0.1:8130
public_host=${host:-}
tls_port=8443
email=
# token — the string in the URL your phone saves; mtls — a certificate on the
# device, handed over by 'roost enroll' and revocable when a phone is lost.
client_auth=${lock:-token}
EOF
	ok "wrote $CONF"
	log "next: roost up"
	if [ "${profile:-pinned}" != direct ] && [ -z "${proxy:-}" ]; then
		warn "no proxy given: on the '${profile:-pinned}' profile the agent has no network at all"
		warn "put PROXY_URL in $PROXY_ENV, or set proxy_url in $CONF and re-run 'roost install'"
	fi
}

# set_conf rewrites one key in the config file, so a value roost worked out for
# itself — the path an installer chose for the agent, say — is recorded where
# the operator can read and change it, rather than derived again on every run.
set_conf() {
	local key="$1" value="$2"
	[ -f "$CONF" ] || die "no $CONF to write $key into"
	if grep -q "^$key=" "$CONF"; then
		# The value can contain slashes and other regex punctuation, so it is
		# substituted through a here-doc rather than sed's replacement text.
		local tmp; tmp="$(mktemp)"
		while IFS= read -r line; do
			case "$line" in
				"$key="*) printf '%s=%s\n' "$key" "$value" ;;
				*) printf '%s\n' "$line" ;;
			esac
		done < "$CONF" > "$tmp"
		mv "$tmp" "$CONF"
	else
		printf '%s=%s\n' "$key" "$value" >> "$CONF"
	fi
}

# read_state prints one KEY's value from a file roost's roles wrote. Those
# files live under /etc and some are readable only by root, so the fallback is
# sudo rather than a failure.
read_state() {
	local key="$1" file="$2"
	if [ -r "$file" ]; then
		sed -n "s/^$key=//p" "$file" | tail -n1
	elif [ -e "$file" ] || sudo -n test -e "$file" 2>/dev/null; then
		sudo sed -n "s/^$key=//p" "$file" 2>/dev/null | tail -n1
	fi
}

# --- ansible, which may not be here yet ---------------------------------
# The first thing a fresh machine is missing. Left as an error message, "one
# command" starts with a trip to the package manager — so this installs it, out
# loud, and only what is needed: the roles use ansible.builtin only, and the
# `systemd` module they call has been there since core 2.10.
ensure_ansible() {
	command -v ansible-playbook >/dev/null && return 0
	[ -z "${ROOST_NO_BOOTSTRAP:-}" ] ||
		die "ansible is not installed, and ROOST_NO_BOOTSTRAP is set"

	local install=""
	if command -v apt-get >/dev/null; then install="apt-get install -y ansible-core"
	elif command -v dnf >/dev/null; then install="dnf install -y ansible-core"
	elif command -v pacman >/dev/null; then install="pacman -S --noconfirm ansible"
	elif command -v zypper >/dev/null; then install="zypper install -y ansible"
	elif command -v apk >/dev/null; then install="apk add ansible"
	else die "ansible is not installed and no known package manager to install it with"
	fi

	log "ansible is not here yet — installing it: sudo $install"
	if command -v apt-get >/dev/null; then
		sudo apt-get update -qq || true
	fi
	# shellcheck disable=SC2086 # the command is ours, word splitting is intended
	sudo $install || die "could not install ansible — install it yourself and re-run"
	command -v ansible-playbook >/dev/null || die "ansible still is not on PATH after installing it"
	ok "ansible $(ansible-playbook --version | head -1 | sed 's/^ansible-playbook //')"
}

# run_playbook runs one of roost's playbooks against this machine. The
# inventory is written each time rather than kept: a stand configures itself,
# and a file listing "localhost" is not worth leaving behind for somebody to
# find and wonder about.
# Cleaning up by hand rather than with `trap ... RETURN`: a RETURN trap is not
# scoped to the function that sets it, so the next function called replaces it —
# and the file the caller meant to remove stays behind. Measured, after writing
# it the other way: with a RETURN trap in this function, the temporary file
# holding the proxy password in cmd_install was still in /tmp afterwards.
run_playbook() {
	local playbook="$1"; shift
	ensure_ansible
	local inv rc=0
	inv="${TMPDIR:-/tmp}/roost-inventory.$$"
	printf '[stand]\nlocalhost ansible_connection=local\n' > "$inv"
	ansible-playbook -i "$inv" "$ROOT/ansible/playbooks/$playbook" "$@" || rc=$?
	rm -f "$inv"
	return "$rc"
}

# --- install ------------------------------------------------------------

cmd_install() {
	load_conf
	check_conf

	# The proxy password does not go on a command line: every account on the
	# machine can read /proc/<pid>/cmdline while the run lasts. A 0600 vars
	# file passed as -e @file keeps it out of the process list, and the role
	# writing it is no_log already.
	local vars="" rc=0
	if [ -n "$proxy_url" ]; then
		vars="${TMPDIR:-/tmp}/roost-vars.$$"
		(umask 077; printf 'egress_sandbox_proxy_url: "%s"\n' "$proxy_url" > "$vars")
		# EXIT, not RETURN, and expanded now rather than later: an interrupted
		# run must not leave the proxy password in /tmp, and by the time an EXIT
		# trap fires this function's variables are gone.
		# shellcheck disable=SC2064
		trap "rm -f '$vars'" EXIT
	fi

	log "applying the configuration"
	run_playbook stand.yml --tags egress,sessions,env \
		-e "egress_sandbox_profile=$egress_profile" \
		-e "egress_sandbox_agent_command=$(resolved_agent_command)" \
		-e "agent_sessions_user=$(id -un)" \
		-e "agent_sessions_project_dir=$project_dir" \
		-e "env_sync_user=$(id -un)" \
		-e "env_sync_repo=$env_repo" \
		-e "env_sync_version=$env_branch" \
		-e "env_sync_dir=$project_dir/dotfiles" \
		-e "{\"egress_sandbox_users\": [\"$(id -un)\"]}" \
		-e "{\"egress_sandbox_agents\": $(agents_json)}" \
		${vars:+-e "@$vars"}

	ok "the sandbox is configured"
	log "next: roost doctor"
}

# resolved_agent_command answers "which binary does a session start?".
#
# The config file wins, because a value somebody typed is a decision. When it is
# empty, the answer is whatever `roost agent` recorded — which is the normal
# case on a machine where roost installed the agent itself, and it matters that
# the launcher gets that path rather than the default: a launcher pointing at a
# binary that is not there gives a session that closes the instant it opens.
resolved_agent_command() {
	if [ -n "$agent_command" ]; then
		printf '%s\n' "$agent_command"
		return 0
	fi
	local installed; installed="$(read_state AGENT_INSTALLED_COMMAND "$AGENT_STATE")"
	printf '%s\n' "${installed:-/usr/local/bin/claude}"
}

# sandbox_group answers "which group is the policy written for?".
#
# Taken from the file the sandbox itself wrote, so a machine that has a sandbox
# has one answer rather than a second default kept somewhere else. Two defaults
# for one setting is a defect with its own history here: the update script and
# the wrapper had one each for the sandbox group, they drifted, and what the
# machine reported was a wrapper that worked while every update died on a group
# that does not exist on it. The fallback is for the first run of a new stand,
# where the sandbox has not been applied yet and there is no file to read.
sandbox_group() {
	local group
	group="$(sed -n 's/^AGENT_GROUP=//p' "$AGENT_RUN_ENV" 2>/dev/null | tail -n1)"
	printf '%s\n' "${group:-agent-sandbox}"
}

# --- the agent, the terminal, the way in --------------------------------
# Three commands rather than three more responsibilities for `install`: each
# touches something the machine may already have an owner for, and each says so
# rather than assuming.

cmd_agent() {
	load_conf
	log "making sure there is an agent to sandbox"
	run_playbook stand.yml --tags agent \
		-e "agent_cli_user=$(id -un)" \
		-e "agent_cli_install=$agent_install" \
		-e "agent_cli_sandbox_group=$(sandbox_group)" \
		${agent_command:+-e "agent_cli_command=$agent_command"} \
		${proxy_url:+-e "agent_cli_proxy_url=$proxy_url"}

	# Recorded in the config file, not just in /etc: the next `roost install`
	# reads it from there, and the operator can see what was chosen.
	local found; found="$(read_state AGENT_INSTALLED_COMMAND "$AGENT_STATE")"
	if [ -n "$found" ] && [ "$found" != "$agent_command" ]; then
		set_conf agent_command "$found"
		ok "agent_command=$found (written to $CONF)"
	fi
}

cmd_terminal() {
	load_conf
	case "$terminal" in
		true | yes | 1) ;;
		*) log "terminal=$terminal in $CONF — not installing one"; return 0 ;;
	esac
	log "installing the web terminal"
	run_playbook stand.yml --tags terminal \
		-e "terminal_user=$(id -un)" \
		-e "terminal_listen=$listen" \
		-e "terminal_project_dir=$project_dir" \
		${ROOST_POCKTERM_SRC:+-e "terminal_src=$ROOST_POCKTERM_SRC"} \
		${ROOST_POCKTERM_REPO:+-e "terminal_repo=$ROOST_POCKTERM_REPO"}
	ok "the terminal answers on $listen"
}

# cmd_tunnel is the stand's half of being reachable from somewhere else: a key of
# roost's own and a unit holding one reverse forward open. The gate's half is
# cmd_gate, which prints it.
cmd_tunnel() {
	load_conf
	[ -n "$gate" ] || die "no gate in $CONF — a machine with a public address does not need one, and one without needs 'gate=user@host'"
	log "opening a way in through $gate"
	run_playbook stand.yml --tags tunnel \
		-e "tunnel_user=$(id -un)" \
		-e "tunnel_gate=$gate" \
		-e "tunnel_remote_port=$gate_port" \
		-e "tunnel_local=$listen"
	log "next: roost gate — what to add on $gate"
}

# cmd_gate prints what the far end needs, and can put it there.
#
# Printing is the default and not a fallback. The gate is somebody else's
# machine: roost has no state file on it, cannot know what else its nginx serves,
# and must not be the thing that reloads it by surprise. What --apply does is
# narrow on purpose — two files named after roost and one line in the tunnel
# account's authorized_keys — and it refuses if that account does not exist,
# because creating accounts on another machine is the operator's decision.
cmd_gate() {
	load_conf
	local apply="" assume_yes="" target=""
	while [ $# -gt 0 ]; do
		case "$1" in
			--apply) apply=1 ;;
			--yes | -y) assume_yes=1 ;;
			*) die "unknown option $1 (expected --apply, --yes)" ;;
		esac
		shift
	done

	local pubkey port host_name
	pubkey="$(read_state TUNNEL_PUBKEY "$TUNNEL_STATE")"
	port="$(read_state TUNNEL_REMOTE_PORT "$TUNNEL_STATE")"
	[ -n "$pubkey" ] || die "no tunnel on this machine yet — run 'roost tunnel' first"
	[ -n "$port" ] || port="$gate_port"
	target="$(read_state TUNNEL_GATE "$TUNNEL_STATE")"
	[ -n "$target" ] || target="$gate"
	host_name="${public_host:-<the name that points at the gate>}"

	local key_line vhost
	# `restrict` turns everything off — no shell, no agent forwarding, no pty —
	# and then one permission is turned back on: this forward, on loopback, and
	# no other. A key that can only do that is a key worth having on a machine
	# you do not own.
	key_line="restrict,port-forwarding,permitlisten=\"127.0.0.1:$port\" $(cat "$pubkey" 2>/dev/null || sudo cat "$pubkey" 2>/dev/null || echo '<the stand key: cat '"$pubkey"'>')"

	vhost="$(gate_vhost "$host_name" "$port")"

	cat <<EOF

The gate's half. Three files and one line, all named after roost so they can be
taken back out by name — and nothing else on that machine is touched.

1. An account for the tunnel and nothing else, if it is not there yet:

     sudo useradd -m -s /usr/sbin/nologin roost-tunnel

   A shell is not needed: the key below cannot ask for one.

2. Its authorized_keys — one line, one permitted forward:

$key_line

3. /etc/ssh/sshd_config.d/roost-tunnel.conf, so that forward is allowed at all:

$(gate_sshd_snippet)

   Said rather than assumed: the default is usually to allow forwarding, and a
   hardened sshd usually is not the default. A refused forward looks from the
   stand like a tunnel that will not stay up, and from the gate like nothing at
   all — this file is the difference. Reload sshd after adding it
   (\`sudo systemctl reload ssh\` or \`sshd\`, depending on the distribution);
   existing sessions are unaffected.

4. /etc/nginx/conf.d/roost-terminal.conf on the gate:

$vhost

5. A certificate for $host_name, on the gate (it has the address, so it is the
   one that can prove the name):

     sudo certbot certonly --webroot -w /var/www/html -d $host_name
     sudo nginx -t && sudo systemctl reload nginx
EOF

	if [ "$client_auth" = mtls ]; then
		cat <<EOF

6. The lock is client certificates, and the front asking for them is now the
   gate's nginx — so it needs this stand's authority certificate:

     scp $(read_state EXPOSE_CA_DIR "$EXPOSE_STATE" 2>/dev/null || echo /etc/roost/ca)/ca.crt \
         $(read_state EXPOSE_CA_DIR "$EXPOSE_STATE" 2>/dev/null || echo /etc/roost/ca)/ca.crl \
         ${target%%:*}:/tmp/ && \
       ssh ${target%%:*} 'sudo install -D -m644 /tmp/ca.crt /etc/roost/ca/ca.crt && sudo install -m644 /tmp/ca.crl /etc/roost/ca/ca.crl'

   And the revocation list has to travel again every time a device is revoked —
   a list the front never re-reads is a lock that never lets go.
EOF
	fi

	echo
	if [ -z "$apply" ]; then
		log "nothing was changed on $target — add the above, or re-run: roost gate --apply"
		return 0
	fi

	[ -n "$target" ] || die "no gate to apply to"
	if [ -z "$assume_yes" ]; then
		cat <<EOF
--apply will, on $target, over your own ssh access:
  · append that one line to roost-tunnel's authorized_keys (refusing if the
    account is not there)
  · write /etc/ssh/sshd_config.d/roost-tunnel.conf and reload sshd
  · write /etc/nginx/conf.d/roost-terminal.conf
  · run nginx -t, and reload nginx only if it passes

It will not create the account, obtain the certificate, or touch any other file.

EOF
		local reply
		read -rp "Proceed? [y/N] " reply
		case "$reply" in y | Y | yes) ;; *) die "cancelled" ;; esac
	fi
	gate_apply "$target" "$key_line" "$vhost"
}

# gate_sshd_snippet is the one sshd setting the forward depends on, scoped to the
# tunnel's account. A hardened sshd — which is what a machine worth using as a
# gate usually has — refuses port forwarding outright, and then the stand's unit
# restarts forever against a gate that says no.
gate_sshd_snippet() {
	cat <<'EOF'
# Written for the gate by 'roost gate'. Removable by name.
Match User roost-tunnel
    AllowTcpForwarding yes
    PermitTTY no
    X11Forwarding no
    AllowAgentForwarding no
    PermitTunnel no
EOF
}

# gate_vhost prints the gate's nginx file: the same rules as the local front,
# proxying into the far end of the forward instead of into a local port.
#
# The optional pieces are built into variables first rather than substituted
# inside the heredoc: nginx configuration is full of $variables that must not be
# expanded by the shell, and mixing the two kinds of dollar in one place is how
# that goes wrong quietly.
gate_vhost() {
	local name="$1" port="$2" verify="" guard=""
	if [ "$client_auth" = mtls ]; then
		verify=$'\n    ssl_client_certificate /etc/roost/ca/ca.crt;\n    ssl_crl                /etc/roost/ca/ca.crl;\n    ssl_verify_client      optional;\n    ssl_verify_depth       2;'
		guard=$'        if ($ssl_client_verify != SUCCESS) {\n            return 403 "This terminal wants a client certificate. Run \'roost enroll <device>\' on the stand.\\n";\n        }\n'
	fi
	cat <<EOF
# Written for the gate by 'roost gate'. Removable by name.
map \$http_upgrade \$roost_connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name $name;

    ssl_certificate     /etc/letsencrypt/live/$name/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/$name/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;$verify

    add_header X-Robots-Tag "noindex, nofollow" always;
    add_header X-Frame-Options "DENY" always;
    client_max_body_size 25m;

    location / {
$guard        # The far end of the stand's reverse forward. Loopback: the forward is
        # bound there, and a gate that offered this port to the internet would
        # be offering the terminal with no lock in front of it.
        proxy_pass http://127.0.0.1:$port;

        # \$http_host and not \$host: the terminal refuses a WebSocket upgrade
        # whose Origin and Host disagree, and only \$http_host keeps a port.
        proxy_set_header Host \$http_host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;

        proxy_http_version 1.1;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection \$roost_connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }
}
EOF
}

# gate_apply does the narrow version of the printed instructions, over ssh.
#
# One script, written here and fed to the far end on stdin, rather than a series
# of remote command lines: the quoting is then written once and read once, and
# what runs there is something a person can print and look at. It refuses if the
# account is missing — creating accounts on a machine roost does not own is the
# operator's decision, not a side effect of this command.
gate_apply() {
	local target="${1%%:*}" key_line="$2" vhost="$3"
	local ssh_port=""
	case "$1" in *:*) ssh_port="-p ${1##*:}" ;; esac

	local script; script="${TMPDIR:-/tmp}/roost-gate.$$"
	cat > "$script" <<REMOTE
set -euo pipefail
account=roost-tunnel
if ! id "\$account" >/dev/null 2>&1; then
	echo "there is no \$account here — create it first: sudo useradd -m -s /usr/sbin/nologin \$account" >&2
	exit 1
fi
home="\$(getent passwd "\$account" | cut -d: -f6)"
install -d -m700 -o "\$account" -g "\$account" "\$home/.ssh"
touch "\$home/.ssh/authorized_keys"
line='$key_line'
if ! grep -qxF "\$line" "\$home/.ssh/authorized_keys"; then
	printf '%s\n' "\$line" >> "\$home/.ssh/authorized_keys"
fi
chown -R "\$account:\$account" "\$home/.ssh"
chmod 600 "\$home/.ssh/authorized_keys"
install -d -m755 /etc/ssh/sshd_config.d
cat > /etc/ssh/sshd_config.d/roost-tunnel.conf <<'SSHD'
$(gate_sshd_snippet)
SSHD
# Whichever the unit is called here. Reloaded rather than restarted: a restart
# would drop the very session doing this.
systemctl reload ssh 2>/dev/null || systemctl reload sshd 2>/dev/null || true
cat > /etc/nginx/conf.d/roost-terminal.conf <<'VHOST'
$vhost
VHOST
nginx -t
systemctl reload nginx
REMOTE

	log "applying it on $target"
	# shellcheck disable=SC2086 # ssh_port is ours, and empty when there is none
	if ! ssh $ssh_port "$target" "sudo bash -s" < "$script"; then
		rm -f "$script"
		die "the gate refused it — nothing was reloaded there. The script that ran is what 'roost gate' prints."
	fi
	rm -f "$script"
	ok "the gate holds the key and serves the terminal"
	log "if the certificate is not there yet: sudo certbot certonly --webroot -w /var/www/html -d ${public_host:-<your name>}"
}

cmd_expose() {
	load_conf
	local assume_yes="" front=auto
	while [ $# -gt 0 ]; do
		case "$1" in
			--yes | -y) assume_yes=1 ;;
			--print) front=print ;;
			--host) shift; public_host="${1:-}" ;;
			--email) shift; email="${1:-}" ;;
			*) die "unknown option $1 (expected --yes, --print, --host, --email)" ;;
		esac
		shift
	done

	# The one outward-facing step, and the one that touches a service roost may
	# not own. Asked once, plainly, with what is behind the address.
	if [ "$front" != print ] && [ -z "$assume_yes" ]; then
		cat <<EOF
This publishes the terminal at ${public_host:-an sslip.io name for this machine}:${tls_port}

  · roost adds one nginx file (/etc/nginx/conf.d/roost-terminal.conf) and
    reloads nginx — every other file on this machine stays as it is
  · a certificate is requested from Let's Encrypt for that name
  · behind the address is a full shell as $(id -un), reached with the token
    in the URL your phone saves. Treat it like SSH.

EOF
		local reply
		read -rp "Proceed? [y/N] " reply
		case "$reply" in y | Y | yes) ;; *) die "cancelled" ;; esac
	fi

	run_playbook stand.yml --tags expose \
		-e "expose_front=$front" \
		-e "expose_client_auth=$client_auth" \
		-e "expose_upstream=$listen" \
		-e "expose_tls_port=$tls_port" \
		-e "expose_reload_allowed=true" \
		-e "expose_terminal_user=$(id -un)" \
		${public_host:+-e "expose_host=$public_host"} \
		${email:+-e "expose_email=$email"}

	local url; url="$(read_state EXPOSE_URL "$EXPOSE_STATE")"
	[ -z "$url" ] || ok "the terminal is reachable at $url"
	if [ "$client_auth" = mtls ] && [ -n "$url" ]; then
		log "the door wants a client certificate — let a device in with:"
		log "  roost enroll phone"
	fi
}

# cmd_enroll hands one device its way in, when the lock is a certificate rather
# than a token.
#
# Two things come out of it and both are needed: a QR code with a one-time link
# to the device's bundle, and the password its importer will ask for. The bundle
# itself cannot be in the code — it is 4.4KB against a QR's 2953-byte ceiling,
# measured rather than assumed — so the code is a link, and the link stops
# existing ten minutes later whether or not it was used.
cmd_enroll() {
	load_conf
	local device="${1:-}"
	[ -n "$device" ] || die "which device? e.g. roost enroll phone"
	[ "$client_auth" = mtls ] ||
		die "client_auth is '$client_auth' in $CONF — enrolment is for the mtls lock. Set it and re-run 'roost expose'."
	local url
	url="$(read_state EXPOSE_URL "$EXPOSE_STATE")"
	[ -n "$url" ] || die "nothing published yet — run 'roost expose' first"
	command -v "$ENROLL_BIN" >/dev/null || [ -x "$ENROLL_BIN" ] ||
		die "$ENROLL_BIN is not there — run 'roost expose' with client_auth=mtls"

	local out link password expires
	out="$(sudo "$ENROLL_BIN" "$device")" || die "enrolment failed for '$device'"
	link="$(printf '%s\n' "$out" | sed -n 's/^url=//p')"
	password="$(printf '%s\n' "$out" | sed -n 's/^password=//p')"
	expires="$(printf '%s\n' "$out" | sed -n 's/^expires=//p')"
	[ -n "$link" ] || die "the enrolment command printed no link"

	log "on $device: scan this, then open the file it downloads"
	if command -v "$POCKTERM_BIN" >/dev/null; then
		"$POCKTERM_BIN" qr "$link"
	else
		echo "  $link"
	fi
	echo
	echo "  password for the import: $password"
	echo "  the link stops working in ${expires:-a few minutes}, used or not"
	echo
	echo "  Android: the download opens the importer; name it anything, and pick"
	echo "           \"VPN and apps\" when it asks what the certificate is for."
	echo "  iOS:     Settings offers the profile, then Settings → General →"
	echo "           About → Certificate Trust Settings to turn it on."
	echo
	echo "  After it is imported, open the terminal itself: roost qr"
	echo "  If the phone is lost: sudo $CA_BIN revoke $device && sudo systemctl reload nginx"
}

# cmd_token replaces the terminal's shared token.
#
# The one thing the token lock needed and did not have: a way out of a token that
# has been seen. It lives in a URL, so it is also in browser history and in the
# front's logs — and until now changing it meant editing pockterm's env file by
# hand and remembering the restart.
#
# It asks first, because the cost is not local: every phone holding the old link
# stops working, and there is no way to keep one and not another.
cmd_token() {
	load_conf
	local assume_yes=""
	while [ $# -gt 0 ]; do
		case "$1" in
			--yes | -y) assume_yes=1 ;;
			*) die "unknown option $1 (expected --yes)" ;;
		esac
		shift
	done

	[ -n "$(read_state TERMINAL_LISTEN "$TERMINAL_STATE")" ] ||
		die "no terminal installed by roost here — nothing to rotate"
	command -v "$POCKTERM_BIN" >/dev/null ||
		die "$POCKTERM_BIN is not there — run 'roost terminal'"

	if [ "$client_auth" = mtls ]; then
		warn "the lock here is client certificates; the token is not what the door asks for"
	fi
	if [ -z "$assume_yes" ]; then
		cat <<EOF
This replaces the terminal's token. Every device holding the old link stops
working and has to scan a new code — there is no way to keep one and not another.

EOF
		local reply
		read -rp "Proceed? [y/N] " reply
		case "$reply" in y | Y | yes) ;; *) die "cancelled" ;; esac
	fi

	local fresh
	fresh="$("$POCKTERM_BIN" token)" || die "could not generate a token"
	[ -n "$fresh" ] || die "the terminal produced an empty token"

	# Rewritten in place rather than appended: systemd reads the last assignment
	# in the file, so a second POCKTERM_TOKEN line makes "did it change?" depend
	# on file order.
	if sudo grep -q '^POCKTERM_TOKEN=' "$TERMINAL_ENV" 2>/dev/null; then
		sudo sed -i "s|^POCKTERM_TOKEN=.*|POCKTERM_TOKEN=$fresh|" "$TERMINAL_ENV"
	else
		printf 'POCKTERM_TOKEN=%s\n' "$fresh" | sudo tee -a "$TERMINAL_ENV" >/dev/null
	fi
	sudo chmod 600 "$TERMINAL_ENV"
	# The service reads that file when it starts, so without this the old token
	# is still the one in effect and the new code would open a 401.
	sudo systemctl restart pockterm
	ok "the token is replaced, and the terminal restarted to read it"
	echo
	cmd_qr
}

# cmd_qr ends the install with something to point a camera at. The pieces come
# from the files the roles wrote — the address from roost's, the token from
# pockterm's — and the code itself from pockterm, which already knows how to
# draw one.
cmd_qr() {
	local url token
	url="$(read_state EXPOSE_URL "$EXPOSE_STATE")"
	[ -n "$url" ] || die "nothing published yet — run 'roost expose' first"
	token="$(read_state POCKTERM_TOKEN "$TERMINAL_ENV")"
	command -v "$POCKTERM_BIN" >/dev/null ||
		die "$POCKTERM_BIN is not installed — run 'roost terminal'"

	log "scan this with the phone you want the terminal on"
	POCKTERM_PUBLIC_URL="$url" POCKTERM_TOKEN="$token" "$POCKTERM_BIN" qr
	echo
	if [ -n "$token" ]; then
		echo "  The token is in that URL, so it is also in your phone's history"
		echo "  and in the front's logs. For something you keep, put client"
		echo "  certificates in front instead — see README."
	fi
	echo "  On the phone: open it, then \"Add to home screen\"."
}

# cmd_up is the one command the README promises. Each step is the command above
# it, in the order a machine needs them: an agent to sandbox, a sandbox around
# it, a terminal to reach it through, a way in, and a code to scan.
cmd_up() {
	local assume_yes=""
	while [ $# -gt 0 ]; do
		case "$1" in
			--yes | -y) assume_yes=1 ;;
			--host) shift; ROOST_HOST="${1:-}" ;;
			--email) shift; ROOST_EMAIL="${1:-}" ;;
			*) die "unknown option $1 (expected --yes, --host, --email)" ;;
		esac
		shift
	done

	[ -f "$CONF" ] || cmd_setup
	load_conf
	[ -z "${ROOST_HOST:-}" ] || set_conf public_host "$ROOST_HOST"
	[ -z "${ROOST_EMAIL:-}" ] || set_conf email "$ROOST_EMAIL"

	cmd_agent
	cmd_install
	cmd_terminal
	if [ -n "$gate" ]; then
		# A machine with no address of its own: the terminal stays on loopback
		# here and is reached through the gate, whose nginx is the front. There
		# is nothing for `expose` to do on this machine — and the certificate
		# belongs where the address is.
		cmd_tunnel
		cmd_gate
	else
		cmd_expose ${assume_yes:+--yes}
	fi
	cmd_doctor || warn "doctor found something — the lines above say what"
	echo
	if [ "$client_auth" = mtls ]; then
		# The terminal's own QR would only produce a 403 on a phone with no
		# certificate yet, so the enrolment code is what this run ends with.
		cmd_enroll "${ROOST_DEVICE:-phone}"
	else
		cmd_qr
	fi
}

# --- projects -----------------------------------------------------------
# projects.conf lists the repositories that belong on every machine you work
# from, one per line:
#
#   notes   https://git.example/you/notes.git
#   webapp  https://github.com/example/webapp.git  develop
#
# It is a list of what should be present, not a handover from one machine to
# another: this command brings the machine it runs on up to the list, and the
# stand and the workstation run it the same way. What they share is the
# repository.
#
# A project's Claude settings and CLAUDE.md travel inside its own repository,
# so putting the code here is all that is needed.

PROJECTS_CONF="${ROOST_PROJECTS:-$ROOT/projects.conf}"

# parse_projects prints the list as JSON for ansible.
parse_projects() {
	local first=1 name repo version
	printf '['
	while read -r name repo version; do
		case "$name" in '' | \#*) continue ;; esac
		if [ -z "$repo" ]; then
			printf '\n' >&2
			die "cannot read this line of $PROJECTS_CONF: $name $repo $version"
		fi
		[ $first -eq 1 ] || printf ','
		first=0
		printf '{"name":"%s","repo":"%s","version":"%s"}' \
			"$name" "$repo" "${version:-HEAD}"
	done < "$PROJECTS_CONF"
	printf ']\n'
}

cmd_projects() {
	load_conf_optional
	if [ ! -f "$PROJECTS_CONF" ]; then
		log "no projects listed — create $PROJECTS_CONF to have them checked out here"
		return 0
	fi
	local list; list="$(parse_projects)"
	if [ "${1:-}" = "--list" ]; then
		printf '%s\n' "$list"
		return 0
	fi
	[ "$list" != "[]" ] || { log "no projects listed in $PROJECTS_CONF"; return 0; }

	log "bringing this machine up to $PROJECTS_CONF"
	run_playbook projects.yml \
		-e "projects_user=$(id -un)" \
		-e "projects_dir=$project_dir" \
		-e "{\"projects_list\": $list}"
}

# --- uninstall ----------------------------------------------------------
# Removing something is worth being explicit about, so this prints what will
# go and what will stay, and asks — unless told not to.

cmd_uninstall() {
	local purge="" assume_yes="" dry=""
	while [ $# -gt 0 ]; do
		case "$1" in
			--purge)   purge=1 ;;
			--yes|-y)  assume_yes=1 ;;
			--dry-run) dry=1 ;;
			*) die "unknown option $1 (expected --purge, --yes, --dry-run)" ;;
		esac
		shift
	done

	# What goes depends on what roost put there, and the state files are the
	# record of that. A machine whose terminal predates roost keeps it, and
	# says so here rather than after the fact.
	# Everything the teardown playbook acts on is named here, or the preview
	# understates what a confirmation is being asked for.
	local had_terminal="" had_expose="" had_tunnel="" had_ca="" tunnel_gate=""
	[ -z "$(read_state TERMINAL_UNIT "$TERMINAL_STATE")" ] || had_terminal=1
	[ -z "$(read_state EXPOSE_VHOST "$EXPOSE_STATE")" ] || had_expose=1
	[ -z "$(read_state TUNNEL_UNIT "$TUNNEL_STATE")" ] || had_tunnel=1
	[ -z "$(read_state EXPOSE_CA_DIR "$EXPOSE_STATE")" ] || had_ca=1
	tunnel_gate="$(read_state TUNNEL_GATE "$TUNNEL_STATE")"

	cat <<EOF
This removes from $(hostname):
  · the egress rules and their unit
  · the agent launcher and the session helper
  · /etc/roost
$( [ -n "$had_terminal" ] && echo "  · the web terminal roost installed, and its unit" )
$( [ -n "$had_expose" ] && echo "  · roost's nginx file, followed by a reload" )
$( [ -n "$had_tunnel" ] && echo "  · roost's own reverse tunnel${tunnel_gate:+ to $tunnel_gate}: its unit and its key" )
$( [ -n "$had_ca" ] && echo "  · the certificate authority roost created, and the enrolment directory —" \
        && echo "    the certificates already on devices stop being accepted anywhere" )

It keeps:
  · your projects and any running tmux sessions
  · the agent binary, and whatever it is logged in as
$( [ -n "$had_expose" ] && echo "  · the certificate (still valid; delete it with certbot if you want it gone)" )
$( [ -n "$tunnel_gate" ] && echo "  · the gate's half — only its owner can remove that, and the run prints it" )
  · anything else on this machine — a terminal roost did not install, your shell
  · $( [ -n "$purge" ] && echo "nothing else — --purge was given" \
        || echo "the sandbox group (use --purge to remove it)" )
EOF

	if [ -n "$dry" ]; then
		log "dry run: nothing was changed"
		return 0
	fi
	if [ -z "$assume_yes" ]; then
		local reply
		read -rp "Proceed? [y/N] " reply
		case "$reply" in y | Y | yes) ;; *) die "cancelled" ;; esac
	fi

	run_playbook teardown.yml ${purge:+-e roost_purge=true}

	# The config is roost's own; with the machine cleaned it only misleads.
	if [ -n "$purge" ] && [ -f "$CONF" ]; then
		rm -f "$CONF"
		ok "removed $CONF"
	fi
	log "done. If you also want the repository gone: rm -rf $ROOT"
}

# --- doctor -------------------------------------------------------------
# Checks the claims the README makes. Every failure prints what to do, not
# just what is wrong.

cmd_doctor() {
	load_conf
	local failed=0

	if [ "$egress_profile" != direct ]; then
		if systemctl is-active --quiet egress-firewall 2>/dev/null; then
			ok "egress policy is active"
		else
			bad "egress policy is not active — the agent has unrestricted network access"
			echo "      fix: roost install"
			failed=1
		fi

		# The mirror image of the check above, and the one that actually bit:
		# a policy with nothing on the other side leaves the agent with no
		# network, and it dies on its first request.
		if grep -qs '^PROXY_URL=..*' "$PROXY_ENV"; then
			ok "the sandbox has a proxy to reach the internet through"
		else
			bad "no PROXY_URL in $PROXY_ENV — the agent has no network at all"
			echo "      fix: put PROXY_URL=http://user:password@host:port there (0640,"
			echo "           owned by the agent's account), then: systemctl restart"
			failed=1
		fi
	fi

	# The launcher reads this file as the agent's own account. Owned by the
	# group alone it is unreadable to a tmux server that started before the
	# group existed — and the session then dies the instant it is created.
	if [ -f "$PROXY_ENV" ]; then
		local owner perms
		owner="$(stat -c '%U' "$PROXY_ENV")"
		perms="$(stat -c '%a' "$PROXY_ENV")"
		if [ "$owner" = root ]; then
			bad "$PROXY_ENV is owned by root — agent-run cannot read it"
			echo "      fix: chown $(id -un) $PROXY_ENV"
			failed=1
		else
			ok "the launcher can read its credentials file"
		fi
		case "$perms" in
			600 | 640) ;;
			*) bad "$PROXY_ENV has permissions $perms — the proxy password is readable"
			   echo "      fix: chmod 640 $PROXY_ENV"
			   failed=1 ;;
		esac
	fi

	# Each extra agent is a launcher plus the file naming its binary, and a
	# missing binary is the failure that looks like nothing happening: the
	# launcher exits, and a session started for it closes at once.
	local entry name command launcher
	local -a list=()
	IFS=',' read -ra list <<<"$agents"
	for entry in "${list[@]}"; do
		[ -n "$entry" ] || continue
		name="${entry%%:*}" command="${entry#*:}"
		launcher="/usr/local/bin/$name-safe"
		if [ ! -L "$launcher" ]; then
			bad "$launcher is missing — the agent '$name' has no launcher"
			echo "      fix: roost install"
			failed=1
		elif [ ! -x "$command" ]; then
			bad "$launcher points at $command, which is not executable here"
			failed=1
		else
			ok "the agent '$name' can be started as $name-safe"
		fi
	done

	# The agent itself, which every other check here assumes. A path in the
	# config that is not an executable is the same failure as a missing
	# launcher, seen from the other end.
	local agent; agent="$(resolved_agent_command)"
	if [ -x "$agent" ]; then
		ok "the agent is $agent"
	else
		bad "$agent is not an executable file — sessions started for it will close at once"
		echo "      fix: roost agent"
		failed=1
	fi

	# Is that path guarded? A stand can be complete and still leave the
	# shortest way in wide open. Measured on the spare laptop 2026-08-21: every
	# check here was green while `claude` in PATH was a symlink straight at the
	# binary, so anything that typed the agent's name — a shell, a script, a
	# unit, cron, ssh — started it outside the sandbox and left from the
	# machine's own address. The launcher was correct, and nothing was obliged
	# to use it.
	#
	# roost does not install the gate that refuses such a launch: it comes from
	# the operator's own files and also has to work on machines roost does not
	# manage, and a second installer for one path is how two owners begin to
	# disagree over it. What roost owes is the measurement — and a measurement,
	# not a look at the file, because root-owned and executable says nothing
	# about what a file does when it runs.
	if [ "$egress_profile" != direct ] && [ -x "$agent" ]; then
		local own_group sandbox_group
		# The account's login group, not the current one: doctor is often run
		# from inside a sandboxed session (`id -gn` there is the sandbox group),
		# and asking the question under that group answers a different one — the
		# gate would let it through, which is what the gate is for. `id -gn
		# <user>` reads the group from the account, so the measurement is the
		# same wherever doctor is typed.
		own_group="$(id -gn "$(id -un)")"
		sandbox_group="$(sandbox_group)"
		if [ "$own_group" = "$sandbox_group" ]; then
			warn "the login group of $(id -un) is $own_group, the sandbox group itself — nothing here can tell whether $agent refuses a launch from outside the sandbox"
		elif [ -L "$agent" ]; then
			# A symlink is the binary under another name: there is nothing there
			# to refuse with. Reported without running anything — for an agent
			# that is logged in, an unsandboxed start is the risk being
			# described, not an acceptable step in describing it.
			bad "$agent is a symlink to the binary — typing the agent's name starts it outside the sandbox"
			echo "      the launcher is not the only way in: a script, a unit, cron or ssh"
			echo "      calls the name, and this path has nothing to refuse them with"
			echo "      fix: install the gate for it (dotfiles: ./install-agent-gates.sh)"
			failed=1
		elif sg "$own_group" -c "$(printf '%q --version' "$agent")" >/dev/null 2>&1 </dev/null; then
			bad "$agent started outside the sandbox — nothing guards the path a launch without the launcher takes"
			echo "      fix: install the gate for it (dotfiles: ./install-agent-gates.sh)"
			failed=1
		else
			ok "$agent refuses a launch from outside the sandbox"
		fi
	fi

	# Which address does the agent's traffic leave from?
	#
	# This is the claim the pinned profile exists for, and until 2026-08-05 it
	# was the one claim nothing checked: the first stand set up from a config
	# file was pointed at a local proxy that answered, and nobody asked where
	# that proxy came out — it came out of the machine's own address, which is
	# the one thing a fixed exit is supposed to stop mattering. Getting this
	# wrong costs an account, not a debugging session, so the answer is printed
	# whether or not there is an expectation to compare it against.
	if [ "$egress_profile" != direct ] && command -v curl >/dev/null; then
		local group exit_addr own_addr
		group="$(sed -n 's/^AGENT_GROUP=//p' "$AGENT_RUN_ENV" 2>/dev/null | tail -n1)"
		if [ -n "$group" ] && grep -qs '^PROXY_URL=..*' "$PROXY_ENV"; then
			exit_addr="$(sg "$group" -c "set -a; . $PROXY_ENV; export HTTPS_PROXY=\$PROXY_URL; curl -s --max-time 15 $exit_probe" </dev/null 2>/dev/null | tr -d '[:space:]' || true)"
			own_addr="$(curl -s --max-time 15 "$exit_probe" 2>/dev/null | tr -d '[:space:]' || true)"
			if [ -z "$exit_addr" ]; then
				warn "could not work out which address the agent goes out from ($exit_probe did not answer)"
			elif [ -n "$expected_exit" ] && [ "$exit_addr" != "$expected_exit" ]; then
				bad "the agent goes out from $exit_addr, and expected_exit says $expected_exit"
				echo "      an unexpected exit address is how accounts get suspended — check"
				echo "      PROXY_URL in $PROXY_ENV before starting an agent that is logged in"
				failed=1
			elif [ -n "$expected_exit" ]; then
				ok "the agent goes out from $exit_addr, as expected"
			elif [ -n "$own_addr" ] && [ "$exit_addr" = "$own_addr" ]; then
				warn "the agent goes out from $exit_addr — this machine's own address"
				echo "      the proxy changes nothing: the profile is predictable but not"
				echo "      separate. Set expected_exit in $CONF once you know what it"
				echo "      should be."
			else
				warn "the agent goes out from $exit_addr (expected_exit is not set, so nothing was compared)"
			fi

			# The exit address says the proxy works. It does not say the proxy
			# is the only way out — and that is the claim the pinned profile is
			# actually making. A request from inside the group that ignores the
			# proxy variables must not be answered at all; if it is, the policy
			# is not in force and traffic can leave past the proxy while the
			# exit-address check above stays green.
			#
			# Asked with a throwaway curl rather than by starting the agent: for
			# an agent that is logged in, a request from an unexpected address
			# costs the account, so the agent is the one tool that must not be
			# used to test its own network.
			local direct_addr
			direct_addr="$(sg "$group" -c "curl -s --noproxy '*' --max-time 15 $exit_probe" </dev/null 2>/dev/null | tr -d '[:space:]' || true)"
			if [ -n "$direct_addr" ]; then
				bad "the sandbox has a direct way out ($direct_addr) — traffic can leave past the proxy"
				echo "      the exit address above only says the proxy answers; this says"
				echo "      it is not the only way out"
				echo "      fix: roost install, then check: systemctl status egress-firewall"
				failed=1
			else
				ok "no direct way out of the sandbox"
			fi
		fi
	fi

	# Does the sandbox actually reach the provider? The check above says where
	# traffic comes out; this one says it arrives. Both are needed: a proxy can
	# have the right address and refuse the destination, or reach it from an
	# address that gets the account banned.
	if [ "$egress_profile" != direct ] && command -v curl >/dev/null; then
		local group code
		group="$(sed -n 's/^AGENT_GROUP=//p' "$AGENT_RUN_ENV" 2>/dev/null | tail -n1)"
		if [ -n "$group" ] && grep -qs '^PROXY_URL=..*' "$PROXY_ENV"; then
			# 401 is the wanted answer: the request arrived and was told it
			# needs credentials. Anything else means it did not arrive.
			# </dev/null because `sg` asks for the group's password when the
			# caller is not a member — and a diagnostic that hangs waiting for
			# a password nobody set is worse than one that says nothing.
			code="$(sg "$group" -c "set -a; . $PROXY_ENV; export HTTPS_PROXY=\$PROXY_URL; curl -s -o /dev/null -w '%{http_code}' --max-time 15 https://api.anthropic.com/v1/models" </dev/null 2>/dev/null || true)"
			case "$code" in
				401 | 200)
					ok "the sandbox reaches the provider through its proxy (HTTP $code)" ;;
				000 | "")
					bad "nothing answered through the proxy — the agent will fail on its first request"
					echo "      fix: check PROXY_URL in $PROXY_ENV, and that the proxy is up"
					failed=1 ;;
				*)
					warn "the provider answered HTTP $code through the proxy — expected 401"
					echo "      a 403 here usually means the proxy's own exit address is blocked" ;;
			esac
		fi
	fi

	# The terminal, and the address a phone opens. Both are optional — a stand
	# reached over ssh needs neither — so a missing one is said, not failed.
	local t_listen; t_listen="$(read_state TERMINAL_LISTEN "$TERMINAL_STATE")"
	if [ -n "$t_listen" ]; then
		if systemctl is-active --quiet pockterm 2>/dev/null; then
			ok "the web terminal is running on $t_listen"
		else
			bad "the web terminal is installed but not running"
			echo "      fix: systemctl status pockterm; journalctl -u pockterm"
			failed=1
		fi
		# The join between the phone's buttons and the sandbox. Present and
		# wrong is the failure that looks like success: buttons work, sessions
		# start, nothing is sandboxed.
		if [ "$(read_state CLAUDE "$TERMINAL_ENV")" = "/usr/local/bin/agent-run" ]; then
			ok "sessions started from the phone go through the sandbox"
		else
			bad "CLAUDE in $TERMINAL_ENV does not point at agent-run — the phone's buttons start unsandboxed agents"
			echo "      fix: roost terminal"
			failed=1
		fi
	fi

	# The way in, for a machine that has none of its own. A forward that is not
	# holding is the whole reason the terminal is unreachable, and it is invisible
	# from the phone's end: the gate answers, and answers nothing.
	local t_gate; t_gate="$(read_state TUNNEL_GATE "$TUNNEL_STATE")"
	if [ -n "$t_gate" ]; then
		if systemctl is-active --quiet roost-tunnel 2>/dev/null; then
			ok "the tunnel to $t_gate is up"
		else
			bad "the tunnel to $t_gate is not up — nothing reaches this terminal"
			echo "      fix: systemctl status roost-tunnel; journalctl -u roost-tunnel -n 20"
			echo "           a refused forward usually means the gate has not got"
			echo "           this stand's key yet: roost gate"
			failed=1
		fi
	fi

	local url lock; url="$(read_state EXPOSE_URL "$EXPOSE_STATE")"
	lock="$(read_state EXPOSE_CLIENT_AUTH "$EXPOSE_STATE")"
	if [ -n "$url" ] && command -v curl >/dev/null; then
		# Checked from this machine, but through the public name and TLS: that
		# exercises the certificate and the vhost, which is what a phone will
		# meet.
		local out_code
		out_code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 15 "$url/" || true)"
		if [ "$lock" = mtls ]; then
			# Here the interesting answer is a refusal. This request carries no
			# client certificate, so anything that lets it through means the lock
			# is not on — which looks from the outside exactly like a working
			# terminal, and is the failure worth a check of its own.
			case "$out_code" in
				400 | 403)
					ok "$url refuses a request with no client certificate (HTTP $out_code)" ;;
				200)
					bad "$url answered 200 without a client certificate — the lock is not on"
					echo "      fix: roost expose (with client_auth=mtls), then check"
					echo "           ssl_verify_client in the vhost and reload nginx"
					failed=1 ;;
				*)
					bad "$url did not answer (HTTP ${out_code:-none})"
					echo "      fix: nginx -t; systemctl status nginx; and check the name still resolves here"
					failed=1 ;;
			esac
		else
			# A 401 is the terminal asking for the token, i.e. working.
			case "$out_code" in
				200 | 401 | 403)
					ok "$url answers with a valid certificate (HTTP $out_code)" ;;
				*)
					bad "$url did not answer (HTTP ${out_code:-none})"
					echo "      fix: nginx -t; systemctl status nginx; and check the name still resolves here"
					failed=1 ;;
			esac
		fi
	fi

	# The authority behind that lock, and whether anything is still on offer.
	if [ "$lock" = mtls ]; then
		local ca_dir enroll_dir
		ca_dir="$(read_state EXPOSE_CA_DIR "$EXPOSE_STATE")"
		enroll_dir="$(read_state EXPOSE_ENROLL_DIR "$EXPOSE_STATE")"
		if [ -n "$ca_dir" ] && [ -r "$ca_dir/ca.crt" ]; then
			ok "the authority is at $ca_dir"
		elif [ -n "$ca_dir" ]; then
			# Readable only by root is the normal case for the directory; the
			# certificate itself has to be readable by the front.
			if sudo -n test -f "$ca_dir/ca.crt" 2>/dev/null; then
				ok "the authority is at $ca_dir"
			else
				bad "no authority at $ca_dir — devices cannot be enrolled"
				echo "      fix: roost expose"
				failed=1
			fi
		fi
		# A bundle left on offer is a way in sitting on a public path. Its removal
		# is scheduled, so one still here means the timer never fired — a reboot
		# in those ten minutes, say.
		if [ -n "$enroll_dir" ] && [ -d "$enroll_dir" ]; then
			local left; left="$(find "$enroll_dir" -maxdepth 1 -name '*.p12' 2>/dev/null | wc -l)"
			if [ "$left" -gt 0 ]; then
				warn "$left enrolment bundle(s) still published in $enroll_dir"
				echo "      they are a way in until removed: sudo rm $enroll_dir/*.p12"
			fi
		fi
	fi

	if tmux list-sessions >/dev/null 2>&1; then
		ok "tmux is answering"
	else
		warn "no tmux sessions yet — start one: roost-session start <project>"
	fi

	return "$failed"
}

case "${1:-help}" in
	up)        shift; cmd_up "$@" ;;
	setup)     shift; cmd_setup "$@" ;;
	install)   shift; cmd_install "$@" ;;
	agent)     shift; cmd_agent "$@" ;;
	terminal)  shift; cmd_terminal "$@" ;;
	expose)    shift; cmd_expose "$@" ;;
	enroll)    shift; cmd_enroll "$@" ;;
	tunnel)    shift; cmd_tunnel "$@" ;;
	gate)      shift; cmd_gate "$@" ;;
	qr)        shift; cmd_qr "$@" ;;
	token)     shift; cmd_token "$@" ;;
	projects)  shift; cmd_projects "$@" ;;
	uninstall) shift; cmd_uninstall "$@" ;;
	doctor)    shift; cmd_doctor "$@" ;;
	help | -h | --help) usage ;;
	*)       printf 'roost: unknown command %s\n\n' "${1:-}" >&2; usage >&2; exit 1 ;;
esac
