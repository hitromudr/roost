#!/usr/bin/env bash
# roost — set up and check a personal stand for CLI coding agents.
#
#   roost setup     answer a few questions, write roost.conf
#   roost install   apply the configuration to this machine
#   roost doctor    check that the stand is what it claims to be
#   roost qr        show the link for your phone as a QR code
#   roost gate add <user@host>      prepare a public entry point
#   roost gate remove <user@host>   undo that
#   roost projects [--list]         put the projects from projects.conf on this machine
#   roost uninstall [--purge]       remove roost from this machine
#
# Everything it does is an ansible role underneath; this wrapper exists so
# that the common path is one command and the questions are asked once.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONF="${ROOST_CONF:-$ROOT/roost.conf}"

log()  { printf '\033[1;34m[roost]\033[0m %s\n' "$*"; }
ok()   { printf '\033[1;32m  ✓\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m  !\033[0m %s\n' "$*"; }
bad()  { printf '\033[1;31m  ✗\033[0m %s\n' "$*"; }
die()  { printf '\033[1;31m[roost]\033[0m %s\n' "$*" >&2; exit 1; }

usage() {
	sed -n '2,13p' "$ROOT/roost" | sed 's/^# \{0,1\}//'
}

# --- configuration ------------------------------------------------------

load_conf() {
	[ -f "$CONF" ] || die "no $CONF yet — run 'roost setup' first"
	# Simple key=value; no shell in the config file, on purpose.
	egress_profile=pinned agent_command=/usr/local/bin/claude
	gate_host="" gate_domain="" auth=mtls project_dir="$HOME/work"
	while IFS='=' read -r key value; do
		case "$key" in '' | \#*) continue ;; esac
		printf -v "$key" '%s' "$value"
	done < "$CONF"
}

check_conf() {
	case "$auth" in
		token | mtls) ;;
		*) die "auth is '$auth': publishing a terminal without authentication is not supported — set auth=token or auth=mtls" ;;
	esac
	if [ -n "$gate_host" ] && [ -z "$gate_domain" ]; then
		die "gate_host is set but gate_domain is empty — the gate terminates TLS for a name"
	fi
}

cmd_setup() {
	local profile agent gate domain authmode
	log "a few questions; answers go to $CONF and are not asked again"
	read -rp "  egress profile [pinned/proxied/direct] (pinned): " profile
	read -rp "  agent command (/usr/local/bin/claude): " agent
	read -rp "  gate host, empty if this machine is public (): " gate
	if [ -n "$gate" ]; then
		read -rp "  domain the phone opens: " domain
		read -rp "  authentication [mtls/token] (mtls): " authmode
	fi
	cat > "$CONF" <<EOF
# Written by 'roost setup'. Edit freely; 'roost install' reads it.
egress_profile=${profile:-pinned}
agent_command=${agent:-/usr/local/bin/claude}
gate_host=${gate}
gate_domain=${domain:-}
auth=${authmode:-mtls}
project_dir=$HOME/work
EOF
	ok "wrote $CONF"
	log "next: roost install"
}

# --- install ------------------------------------------------------------

cmd_install() {
	load_conf
	check_conf
	command -v ansible-playbook >/dev/null || die "ansible is not installed"

	log "installing collections"
	ansible-galaxy collection install -r "$ROOT/ansible/requirements.yml" --force \
		-p "${ANSIBLE_COLLECTIONS_PATH:-$HOME/.ansible/collections}" >/dev/null

	local inv="${TMPDIR:-/tmp}/roost-inventory.$$"
	printf '[stand]\nlocalhost ansible_connection=local\n' > "$inv"
	trap 'rm -f "$inv"' RETURN

	log "applying the stand configuration"
	ansible-playbook -i "$inv" "$ROOT/ansible/playbooks/stand.yml" \
		-e "egress_sandbox_profile=$egress_profile" \
		-e "egress_sandbox_agent_command=$agent_command" \
		-e "agent_sessions_user=$(id -un)" \
		-e "agent_sessions_project_dir=$project_dir" \
		-e "publish_gate_host=$gate_host" \
		-e "{\"egress_sandbox_users\": [\"$(id -un)\"]}" \
		-e "publish_token=$([ "$auth" = mtls ] && [ -n "$gate_host" ] && echo false || echo true)"

	ok "the stand is configured"
	if [ -n "$gate_host" ]; then
		log "next: roost gate add <user@$gate_host>, then roost doctor"
	else
		log "next: roost doctor"
	fi
}

cmd_gate() {
	local action="${1:-}" target="${2:-}"
	case "$action" in add | remove) ;; *) die "usage: roost gate {add|remove} <user@host>" ;; esac
	[ -n "$target" ] || die "usage: roost gate $action <user@host>"
	load_conf
	[ -n "$gate_domain" ] || die "gate_domain is empty — set it in $CONF"

	local inv="${TMPDIR:-/tmp}/roost-gate-inventory.$$"
	printf '[gate]\n%s ansible_host=%s ansible_user=%s\n' \
		"${target#*@}" "${target#*@}" "${target%@*}" > "$inv"
	trap 'rm -f "$inv"' RETURN

	if [ "$action" = remove ]; then
		log "removing roost from the gate at ${target#*@}"
		ansible-playbook -i "$inv" "$ROOT/ansible/playbooks/gate-teardown.yml" \
			-e "gate_domain=$gate_domain" ${purge:+-e roost_purge=true}
		return
	fi

	check_conf
	log "configuring the gate at ${target#*@}"
	ansible-playbook -i "$inv" "$ROOT/ansible/playbooks/gate.yml" \
		-e "gate_domain=$gate_domain" \
		-e "gate_auth=$auth" \
		-e "gate_tunnel_keys=[\"$(cat /etc/roost/tunnel_key.pub 2>/dev/null || echo '')\"]"
}

# --- projects -----------------------------------------------------------
# projects.conf lists what belongs on this stand, one per line:
#
#   isearch  https://git.example/isearch.git
#   sorter   https://github.com/x/sorter.git  develop
#
# A project's Claude settings and CLAUDE.md travel inside its own repository,
# so putting the code here is all that is needed.

PROJECTS_CONF="${ROOST_PROJECTS:-$ROOT/projects.conf}"

# parse_projects prints the list as JSON for ansible.
parse_projects() {
	local first=1 name repo version
	printf '['
	while read -r name repo version; do
		case "$name" in '' | \#*) continue ;; esac
		if [ -z "$repo" ]; then
			printf '\n' >&2
			die "cannot read this line of $PROJECTS_CONF: $name $repo $version"
		fi
		[ $first -eq 1 ] || printf ','
		first=0
		printf '{"name":"%s","repo":"%s","version":"%s"}' \
			"$name" "$repo" "${version:-HEAD}"
	done < "$PROJECTS_CONF"
	printf ']\n'
}

cmd_projects() {
	load_conf
	if [ ! -f "$PROJECTS_CONF" ]; then
		log "no projects listed — create $PROJECTS_CONF to have them deployed here"
		return 0
	fi
	local list; list="$(parse_projects)"
	if [ "${1:-}" = "--list" ]; then
		printf '%s\n' "$list"
		return 0
	fi
	[ "$list" != "[]" ] || { log "no projects listed in $PROJECTS_CONF"; return 0; }

	command -v ansible-playbook >/dev/null || die "ansible is not installed"
	local inv="${TMPDIR:-/tmp}/roost-inventory.$$"
	printf '[stand]\nlocalhost ansible_connection=local\n' > "$inv"
	trap 'rm -f "$inv"' RETURN

	log "deploying projects"
	ansible-playbook -i "$inv" "$ROOT/ansible/playbooks/projects.yml" \
		-e "projects_user=$(id -un)" \
		-e "projects_dir=$project_dir" \
		-e "{\"projects_list\": $list}"
}

# --- uninstall ----------------------------------------------------------
# Removing something is worth being explicit about, so this prints what will
# go and what will stay, and asks — unless told not to.

cmd_uninstall() {
	local purge="" assume_yes="" dry=""
	while [ $# -gt 0 ]; do
		case "$1" in
			--purge)   purge=1 ;;
			--yes|-y)  assume_yes=1 ;;
			--dry-run) dry=1 ;;
			*) die "unknown option $1 (expected --purge, --yes, --dry-run)" ;;
		esac
		shift
	done

	cat <<EOF
This removes from $(hostname):
  · the egress rules and their unit
  · the agent launcher and the session helper
  · the tunnel to the gate, if any
  · the web terminal, its unit and its checkout
  · /etc/roost

It keeps:
  · your projects and any running tmux sessions
  · $( [ -n "$purge" ] && echo "nothing else — --purge was given" \
        || echo "the sandbox group and /etc/pockterm (use --purge to remove them)" )
EOF

	if [ -n "$dry" ]; then
		log "dry run: nothing was changed"
		return 0
	fi
	if [ -z "$assume_yes" ]; then
		local reply
		read -rp "Proceed? [y/N] " reply
		case "$reply" in y | Y | yes) ;; *) die "cancelled" ;; esac
	fi

	command -v ansible-playbook >/dev/null || die "ansible is not installed"
	local inv="${TMPDIR:-/tmp}/roost-inventory.$$"
	printf '[stand]\nlocalhost ansible_connection=local\n' > "$inv"
	trap 'rm -f "$inv"' RETURN

	ansible-playbook -i "$inv" "$ROOT/ansible/playbooks/teardown.yml" \
		${purge:+-e roost_purge=true}

	# The config is roost's own; with the machine cleaned it only misleads.
	if [ -n "$purge" ] && [ -f "$CONF" ]; then
		rm -f "$CONF"
		ok "removed $CONF"
	fi
	log "done. If you also want the repository gone: rm -rf $ROOT"
}

# --- doctor -------------------------------------------------------------
# Checks the claims the README makes. Every failure prints what to do, not
# just what is wrong.

cmd_doctor() {
	load_conf
	local failed=0

	if [ "$egress_profile" != direct ]; then
		if systemctl is-active --quiet egress-firewall 2>/dev/null; then
			ok "egress policy is active"
		else
			bad "egress policy is not active — the agent has unrestricted network access"
			echo "      fix: roost install"
			failed=1
		fi
	fi

	if systemctl is-active --quiet pockterm 2>/dev/null; then
		ok "web terminal is running"
	else
		bad "web terminal is not running"
		echo "      fix: roost install, then journalctl -u pockterm"
		failed=1
	fi

	if [ -n "$gate_host" ]; then
		if systemctl is-active --quiet roost-tunnel 2>/dev/null; then
			ok "tunnel to $gate_host is up"
		else
			bad "tunnel to $gate_host is down — nothing outside can reach this stand"
			echo "      fix: journalctl -u roost-tunnel; check the key is authorised on the gate"
			failed=1
		fi
	fi

	if [ -f /etc/pockterm/pockterm.env ]; then
		local perms
		perms="$(stat -c '%a' /etc/pockterm/pockterm.env)"
		if [ "$perms" = 600 ]; then
			ok "terminal token is not world-readable"
		else
			bad "/etc/pockterm/pockterm.env has permissions $perms"
			echo "      fix: chmod 600 /etc/pockterm/pockterm.env"
			failed=1
		fi
	fi

	if tmux list-sessions >/dev/null 2>&1; then
		ok "tmux is answering"
	else
		warn "no tmux sessions yet — start one: roost-session start <project>"
	fi

	return "$failed"
}

cmd_qr() {
	load_conf
	local url="${1:-}"
	if [ -z "$url" ] && [ -n "$gate_domain" ]; then
		url="https://$gate_domain/"
	fi
	command -v pockterm >/dev/null || die "pockterm is not installed — run 'roost install'"
	pockterm qr ${url:+"$url"}
}

case "${1:-help}" in
	setup)     shift; cmd_setup "$@" ;;
	install)   shift; cmd_install "$@" ;;
	gate)      shift; cmd_gate "$@" ;;
	projects)  shift; cmd_projects "$@" ;;
	uninstall) shift; cmd_uninstall "$@" ;;
	doctor)  shift; cmd_doctor "$@" ;;
	qr)      shift; cmd_qr "$@" ;;
	help | -h | --help) usage ;;
	*)       printf 'roost: unknown command %s\n\n' "${1:-}" >&2; usage >&2; exit 1 ;;
esac
